{
  "name": "rustyplayer",
  "version": "1.0.0",
  "description": "Video player with thumbnail gallery",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test \"tests/**/*.test.js\"",
    "pack": "electron-builder --dir --win portable",
    "test:coverage": "c8 --check-coverage --lines 80 --branches 70 --functions 80 --reporter=text --reporter=lcov node --test \"tests/**/*.test.js\"",
    "test:e2e": "node --test tests/e2e-smoke.spec.js",
    "bundlesize": "bundlesize"
  },
  "keywords": [
    "video",
    "player",
    "electron"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "c8": "^10.1.3",
    "electron": "^41.2.1",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.1",
    "png-to-ico": "^3.0.1"
  },
  "c8": {
    "lines": 80,
    "branches": 70,
    "functions": 80,
    "statements": 80,
    "reporter": ["text", "lcov"],
    "include": ["src/**/*.js"],
    "exclude": ["tests/**", "scripts/**"]
  },
  "_c8Notes": "branches 70 is temporary — renderer branches low (filter/keyboard/tags); raise to 80 once P1.5/P1.1 branches are covered. CI runs `npm run test:coverage` which expands to `c8 --check-coverage --lines 80 --branches 70 --functions 80`.",
  "bundlesize": [
    {
      "path": "dist/win-unpacked/*.exe",
      "maxSize": "250MB"
    }
  ],
  "_installerVersionNote": "installer.iss version injected from package.json via APP_VERSION env (see build.yml); publish provider github uses version from package.json",
  "build": {
    "appId": "com.rustyplayer.app",
    "productName": "RustyPlayer",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github"
    },
    "compression": "maximum",
    "asar": true,
    "afterPack": "scripts/afterPack.js",
    "win": {
      "target": "portable",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "${productName}-Setup.${ext}",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "assets/**/*"
    ]
  }
}
