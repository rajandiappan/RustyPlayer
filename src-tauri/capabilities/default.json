{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Least-privilege capability for the main window (see TAURI_PORT_PLAN.md §1.1). Backend fs via std/tokio needs no capability; these gate frontend plugin calls only.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "dialog:allow-open",
    "log:default",
    {
      "identifier": "fs:allow-read-file",
      "allow": [{ "path": "$APPDATA/rustyplayer-config.json" }]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        { "path": "$APPDATA/rustyplayer-config.json" },
        { "path": "$APPDATA/rustyplayer-config.json.tmp" },
        { "path": "$APPDATA/rustyplayer-config.json.bak" }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "$APPDATA/rustyplayer-config.json" }]
    }
  ]
}
